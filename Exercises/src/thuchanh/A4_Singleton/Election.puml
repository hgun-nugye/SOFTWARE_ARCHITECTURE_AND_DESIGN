@startuml
'https://plantuml.com/class-diagram

class Election{
    -static Election instance
    - int trumpVotes, biddenVotes
    - Set <String> userWhoVoted
    - Election()
    + static Election getInstance()
    + void submitVote(String candidate, String user)
    + void printResult()
}

class User{
    - String name
    - User(String name)
    + void vote (String candidate)
}

User ..> Election

@enduml